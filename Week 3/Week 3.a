
#include <stdio.h>
#include <math.h>
int main()
{
    float num  , result;
    
    printf("enter a number: ");
    scanf("%f",&num);
    
    if(num >= 0)
    {
        result = sqrt(num);
        printf("square root = %.2f\n",result);
    }
    else
    {
        printf("square root of a negative number is not a real number");
    }

    return 0;
}
